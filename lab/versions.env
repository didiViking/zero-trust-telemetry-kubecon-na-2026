# Pinned lab component versions. Sourced by bootstrap.sh and the tests.
# "Pinned" means chosen and exercised together in this lab; it is NOT a compatibility
# guarantee for other environments. Re-check upstream support matrices before changing.

LAB_CLUSTER_NAME=zt-telemetry-lab
LAB_CONTEXT=kind-zt-telemetry-lab

# kind node image: Kubernetes v1.34.0, default image of kind v0.30.0 (pinned by digest).
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
KIND_MIN_VERSION=0.30.0

# Cilium 1.19.x lists Kubernetes 1.32-1.35 as e2e tested (docs compatibility table).
CILIUM_VERSION=1.19.10
CILIUM_CHART_REPO=https://helm.cilium.io

# cert-manager chart version (docs.cert-manager.io); installed with crds.enabled=true.
CERT_MANAGER_VERSION=v1.20.4
CERT_MANAGER_CHART_REPO=https://charts.jetstack.io

# OpenTelemetry Collector contrib (gateway + backend) and telemetrygen (synthetic client).
# telemetrygen publishes tags per minor (v0.163.0) while contrib has a patch release (0.163.2).
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.163.2
TELEMETRYGEN_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:v0.163.0

# Lab-only helper images (pinned tags).
BUSYBOX_IMAGE=busybox:1.37.0
OPENSSL_IMAGE=alpine/openssl:3.5.4
